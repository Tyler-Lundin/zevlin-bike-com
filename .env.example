# Runtime environment
NODE_ENV=development
APP_ENV=dev
ENFORCE_SELF_HOSTED_REQUIRED=false

# Database
DATABASE_URL=
OLD_DATABASE_URL=

# Auth (Authentik)
AUTHENTIK_BASE_URL=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_ISSUER=

# CMS (Directus)
DIRECTUS_URL=
DIRECTUS_TOKEN=

# Object storage (MinIO)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_REGION=us-east-1
MINIO_FORCE_PATH_STYLE=true

# Cache and idempotency
REDIS_URL=

# Email (managed SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_HTTP_RELAY_URL=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Zevlin Bike

# Payments and shipping (allowed external vendors)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SHIPPO_API_TOKEN=
SHIPPO_WEBHOOK_SECRET=

# Observability (self-hosted)
GRAFANA_URL=
LOKI_URL=
PROMETHEUS_URL=
TEMPO_URL=

# Encryption and keying
# Base64-encoded 32-byte data encryption key for field-level encryption
FIELD_ENCRYPTION_KEY_B64=
FIELD_HASH_SALT=
KMS_KEY_ID=

# Compliance defaults
LOG_RETENTION_MONTHS=13
REQUIRE_STAFF_MFA=true

# Landing/SEO/Analytics
NEXT_PUBLIC_SITE_URL=https://www.zevlinbike.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=
LANDING_INTAKE_EMAIL=
LANDING_SECURITY_EMAIL=security@zevlinbike.com

# Deprecated compatibility keys (do not use for new self-hosted runtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_TOKEN=
BREVO_API_KEY=
DATADOG_API_KEY=
SENTRY_DSN=
